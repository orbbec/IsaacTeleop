include "timestamp.fbs";

namespace core;

// Append-only capture-health summary. Consumers can filter incomplete runs
// without inferring state from a partially written media file.
enum EgoCaptureHealth : byte { Healthy = 0, Warning = 1, Incomplete = 2 }
enum EgoConnectionState : byte { Connected = 0, Recovering = 1, Recovered = 2, Failed = 3 }

struct EgoDevicePropertyValue {
  property_id: int32;
  value: double;
}

table EgoDeviceState {
  sequence_number: uint64 (id: 0);
  device_uid: string (id: 1);
  work_mode: int32 (id: 2);
  status_flags: uint64 (id: 3);
  error_flags: uint64 (id: 4);
  storage_free_bytes: uint64 (id: 5);
  temperature_c: float (id: 6);
  properties: [EgoDevicePropertyValue] (id: 7);
  capture_health: EgoCaptureHealth = Healthy (id: 8);
  failure_reason: string (id: 9);
  queue_capacity: uint32 (id: 10);
  queue_peak: uint32 (id: 11);
  dropped_events: uint64 (id: 12);
  capture_epoch: uint32 (id: 13);
  connection_state: EgoConnectionState = Connected (id: 14);
  reconnect_attempt: uint32 (id: 15);
}

table EgoDeviceStateTracked { data: EgoDeviceState (id: 0); }

table EgoDeviceStateRecord {
  data: EgoDeviceState (id: 0);
  timestamp: DeviceDataTimestamp (id: 1);
}

root_type EgoDeviceStateRecord;
